# Build from the backend/ folder:  docker build -f lambda_report/Dockerfile -t rehab-report .
# WeasyPrint needs the pango library; if it is missing the report falls back to matplotlib automatically.
FROM public.ecr.aws/lambda/python:3.12
RUN dnf install -y pango && dnf clean all
COPY lambda_report/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY db.py metrics.py config.py ${LAMBDA_TASK_ROOT}/
COPY reports ${LAMBDA_TASK_ROOT}/reports
COPY lambda_report/handler.py ${LAMBDA_TASK_ROOT}/handler.py
CMD ["handler.handler"]