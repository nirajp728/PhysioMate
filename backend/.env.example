# copy to .env
JWT_SECRET_KEY=change-me
# leave empty to use an in-memory database (data lost on restart); or e.g. a MongoDB Atlas URI
MONGO_URI=
MONGO_DB=rehab
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASYNC_MODE=threading
HEARTBEAT_TIMEOUT=10

# an admin account is created at startup if both are set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# reports are stored on local disk unless S3_BUCKET is set (needs AWS credentials / an IAM role)
REPORT_DIR=report_files
S3_BUCKET=

# --- login cookies (production: HTTPS, so COOKIE_SECURE=1) ---
# Put the website and the API on the same site (app.example.com + api.example.com, COOKIE_DOMAIN=.example.com)
# and keep COOKIE_SAMESITE=Lax. Only if they are on different sites use COOKIE_SAMESITE=None (needs COOKIE_SECURE=1).
COOKIE_SECURE=
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- reports: private S3 bucket, optionally built by a Lambda ---
# S3_BUCKET=my-rehab-reports
# REPORT_LAMBDA=rehab-report      # function name; empty = built inside this server

# --- WebRTC relay (your own coturn, see deploy/coturn/turnserver.conf) ---
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=long-random-string   # same as static-auth-secret in turnserver.conf
# TURN_TTL=3600