FROM python:3.12-slim
# pango: needed by WeasyPrint (without it reports fall back to matplotlib)
RUN apt-get update && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV ASYNC_MODE=gevent
EXPOSE 5000
# ONE worker: live sessions are kept in memory, so several workers would not see each other
CMD ["gunicorn", "-k", "gevent", "-w", "1", "-b", "0.0.0.0:5000", "--timeout", "60", "wsgi:app"]